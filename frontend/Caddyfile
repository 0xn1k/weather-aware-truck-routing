{
    admin off
    persist_config off
    auto_https off
    log {
        format json
    }
    servers {
        trusted_proxies static 0.0.0.0/0 ::/0
    }
}

:{$PORT:3000} {
    log {
        format json
    }

    root * dist

    encode gzip

    # .mjs isn't in every server's default MIME table, and a module Worker
    # (MapLibre GL's tile-processing worker) refuses to execute if its
    # Content-Type isn't a JS type — set it explicitly rather than trust
    # Caddy's built-in guess.
    @mjs path *.mjs
    header @mjs Content-Type "text/javascript; charset=utf-8"

    file_server

    try_files {path} /index.html
}
